{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.wolfhacks.org" }],
      "destination": "https://wolfhacks.org/:path*",
      "permanent": true
    },
    { "source": "/apply", "destination": "/", "permanent": false },
    { "source": "/apply/:path*", "destination": "/", "permanent": false },
    { "source": "/thank-you", "destination": "/", "permanent": false }
  ],
  "services": {
    "frontend": {
      "root": "./",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
