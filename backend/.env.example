# Copy this file to .env and fill in real values. Never commit .env.

# --- Google Sheets ---
# Path to the downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# The ID from https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1ckYK82T8wayiCLtluOkQek4gQ4lwwE2WEvyWRLR6I3M
GOOGLE_SHEETS_RANGE=Applications!A:X

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# Service role key (not the anon key) — required so the backend can insert
# past RLS. Keep this secret, never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_APPLICATIONS_TABLE=applications

# --- App ---
WOLFHACKS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WOLFHACKS_LOG_LEVEL=INFO
